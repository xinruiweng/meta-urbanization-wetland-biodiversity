##1000_times_moderators----
moderator_results <- vector("list", n_iter)

for (i in 1:n_iter) {

  
  
  dat_i <- LRR_shannon_weighted %>%
    group_by(Study_ID) %>%
    slice_sample(n = 1) %>%
    ungroup()
  
  

  results_i <- list()
  
  for (mod in moderators) {
    
    # formula
    formula_i <- as.formula(
      paste("~", mod)
    )
    
    # model
    model_i <- rma.mv(
      yi,
      vi,
      mods = formula_i,
      data = dat_i,
      method = "REML"
    )
    
    # levels
    dat_i[[mod]] <- factor(dat_i[[mod]])
    
    newdat <- data.frame(
      temp = levels(dat_i[[mod]])
    )
    
    names(newdat) <- mod
    
    # design matrix
    X <- model.matrix(
      formula_i,
      data = newdat
    )
    
    # predictions
    pred <- predict(
      model_i,
      newmods = X[, -1, drop = FALSE],
      transf = NULL
    )
    
    
    results_i[[mod]] <- data.frame(
      iteration = i,
      variable = mod,
      category = newdat[[mod]],
      estimate = pred$pred,
      ci_lb = pred$ci.lb,
      ci_ub = pred$ci.ub
    )
  }
  
  moderator_results[[i]] <- bind_rows(results_i)
}

moderator_results <- bind_rows(moderator_results)
str(moderator_results)
write.csv(moderator_results,"TEXT_one_per_study/shannon/moderators_categories_1000.csv")

