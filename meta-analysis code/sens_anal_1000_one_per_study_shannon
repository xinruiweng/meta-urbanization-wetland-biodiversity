base_plot <- function(data, x_lab = NULL, y_lab = NULL) {
  
  ggplot(data, aes(y = category)) +
    
    # sensitivity analysis: boxplot
    geom_boxplot(
      aes(
        xmin = lower_fence,
        xlower = Q1,
        xmiddle = median,
        xupper = Q3,
        xmax = upper_fence
      ),
      stat = "identity",
      width = 0.6,
      orientation = "y"
    ) +
    
    # primary estimate
    geom_point(
      aes(x = primary_estimate),
      size = 3,
      shape = 17,
      color = "#008b8b"
    ) +
    
    # zero reference line
    geom_vline(
      xintercept = 0,
      linetype = "dotted"
    ) +
    
    coord_cartesian(xlim = x_lim) +
    
    labs(x = x_lab,y = y_lab)+
    theme_bw()+ 
    theme(
      axis.title.x = element_text(size = 14),
      axis.title.y = element_text(size = 14),
      axis.text.y = element_text(size = 14)
    )
}

