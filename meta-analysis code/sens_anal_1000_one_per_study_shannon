##type II wald test 1000----

full_formula <- ~ taxa_grouped +
  income_region +
  wetland_type_grouped +
  scale_grouped +
  koppen_climate +
  reference_type

set.seed(123)

n_iter <- 1000

wald_results <- vector("list", n_iter)

for (i in 1:n_iter) {
  
  dat_i <- LRR_shannon_weighted %>%
    group_by(Study_ID) %>%
    slice_sample(n = 1) %>%
    ungroup()
  
  
  
  model_i <- rma.mv(
    yi,
    vi,
    mods = full_formula,
    random = ~ 1 | Study_ID/Plot_ID,
    data = dat_i,
    method = "REML"
  )
  
  
  beta <- model_i$beta
  vb <- model_i$vb
  
  # Type II Wald test
  results_i <- lapply(moderators, function(mod) {
    
    
    term_pos <- grep(
      paste0("^", mod),
      rownames(beta)
    )
    
    # Type II Wald statistic
    wald_stat <- t(beta[term_pos, , drop = FALSE]) %*%
      solve(vb[term_pos, term_pos, drop = FALSE]) %*%
      beta[term_pos, , drop = FALSE]
    
    
    wald_stat <- as.numeric(wald_stat)
    
    # degrees of freedom
    df <- length(term_pos)
    
    # p-value
    p_value <- pchisq(
      wald_stat,
      df = df,
      lower.tail = FALSE
    )
    
    data.frame(
      iteration = i,
      variable = mod,
      Chi2 = wald_stat,
      df = df,
      p = p_value
    )
  })
  
  
  wald_results[[i]] <- bind_rows(results_i)
}

wald_results <- bind_rows(wald_results)
write.csv(wald_results,"TEXT_one_per_study/shannon/wald_1000.csv")
#summary 1000wald test----
wald_summary <- wald_results %>%
  group_by(variable) %>%
  summarise(
    mean_Chi2 = mean(Chi2, na.rm = TRUE),
    median_Chi2 = median(Chi2, na.rm = TRUE),
    lower_2.5 = quantile(Chi2, 0.025, na.rm = TRUE),
    upper_97.5 = quantile(Chi2, 0.975, na.rm = TRUE),
    
    mean_p = mean(p, na.rm = TRUE),
    median_p = median(p, na.rm = TRUE),
    
    proportion_significant = mean(p < 0.05, na.rm = TRUE),
    
    .groups = "drop"
  )
wald_summary
