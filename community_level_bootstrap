  df <- read_csv(
    paste0(
      "bootstrap/bootstrap_",
      i,
      ".csv"
    ),
    show_col_types = FALSE
  )
  
  data.frame(
    file_id = i,
    n_boot = nrow(df),
    n_homo_finite = sum(is.finite(df$LRR_homogeneity)),
    n_shift_finite = sum(is.finite(df$LRR_shift)),
    n_homo_na = sum(!is.finite(df$LRR_homogeneity)),
    n_shift_na = sum(!is.finite(df$LRR_shift))
