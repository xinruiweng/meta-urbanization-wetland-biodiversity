# bootstrap summary
boot_summary <- map_dfr(1:95, function(i) {
  
  file_path <- file.path(
    "bootstrap",
    paste0("bootstrap_", i, ".csv")
  )
  
  df <- read_csv(
    file_path,
    show_col_types = FALSE
  )
  
  homo_finite <- df$LRR_homogeneity[
    is.finite(df$LRR_homogeneity)
  ]
  
  shift_finite <- df$LRR_shift[
    is.finite(df$LRR_shift)
  ]
  
  data.frame(
    file_id = i,
    
    n_finite_homo = length(homo_finite),
    boot_mean_homo = mean(homo_finite),
    boot_sd_homo = sd(homo_finite),
    vi_boot_homo = var(homo_finite),
    
    n_finite_shift = length(shift_finite),
    boot_mean_shift = mean(shift_finite),
    boot_sd_shift = sd(shift_finite),
    vi_boot_shift = var(shift_finite)
  )
})

write_csv(
  boot_summary,
  "bootstrap/bootstrap_summary.csv"
)
